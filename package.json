{
  "name": "n8n-nodes-fiberai",
  "version": "0.1.0",
  "description": "n8n community node for Fiber AI: company and people search, enrichment and contact reveal",
  "license": "MIT",
  "homepage": "https://fiber.ai",
  "keywords": [
    "n8n-community-node-package",
    "fiber",
    "fiberai",
    "enrichment",
    "lead-generation"
  ],
  "author": {
    "name": "Fiber AI",
    "email": "TODO@fiber.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fiber-ai/n8n-nodes-fiberai.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/FiberAiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FiberAi/FiberAi.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
